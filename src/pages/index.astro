---
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/500.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "../styles/global.css";
import { profile, education, research, publications, conferencePublications } from "../data/site";
import { repositoryFallback } from "../data/github";
import RepositoryCard from "../components/RepositoryCard.astro";
import Icon from "../components/Icon.astro";
import ThemeHead from "../components/ThemeHead.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

const publicationGroups = [
  { id: "journal-articles", title: "Journal Articles", papers: publications },
  { id: "conference-papers", title: "Conference Papers", papers: conferencePublications },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Shekun Wang — uncertainty quantification, data-efficient modeling, scientific computing, and photography."
    />
    <ThemeHead />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Shekun Wang</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="wordmark" href="#home" aria-label="Shekun Wang, home">
        sw<span>.</span>
      </a>
      <span class="header-caption">Shekun Wang</span>
      <ThemeToggle />
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="navigation"
      >
        Menu <span>+</span>
      </button>
      <nav id="navigation" aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#education">Education</a>
        <a href="#research">Research</a>
        <a href="#publications">Publications</a>
        <a href="#software">Software</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="home" aria-labelledby="hero-title">
        <div class="hero-stage wrap">
          <canvas class="pointer-field" aria-hidden="true"></canvas>
          <div class="hero-field" aria-hidden="true">
            <div class="halo-aura"></div>
            <div class="halo-orbit halo-orbit-outer"></div>
            <div class="halo-orbit halo-orbit-inner"></div>
            <div class="halo-core"></div>
          </div>
          <div class="hero-copy">
            <h1 id="hero-title">
              Learning more.
              <br />
              From <em>less.</em>
            </h1>
          </div>
          <a class="scroll-cue" href="#about" aria-label="Scroll to About">
            <svg
              class="scroll-chevrons"
              viewBox="0 0 24 32"
              width="32"
              height="42"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m4 7 8 8 8-8" />
              <path d="m4 17 8 8 8-8" />
            </svg>
          </a>
        </div>
      </section>

      <section
        class="about section wrap"
        id="about"
        aria-labelledby="about-title"
      >
        <div class="about-grid reveal">
          <h2 id="about-title">About</h2>
          <div class="about-copy">
            <p>
              I’m Shekun Wang, a master’s student at Northwestern Polytechnical
              University.
            </p>
            <p>
              My research focuses on uncertainty quantification and
              data-efficient surrogate modeling, with a broader interest in
              scientific machine learning.
            </p>
            <p class="personal-note">Outside research, I enjoy photography.</p>
            <a class="text-link" href="/CV.pdf" target="_blank" rel="noopener">
              <Icon name="file" /> View academic CV
            </a>
          </div>
        </div>
      </section>

      <section
        class="education section wrap"
        id="education"
        aria-labelledby="education-title"
      >
        <div class="education-layout reveal">
          <h2 id="education-title">Education</h2>
          <ol class="education-list">
            {education.map((item) => (
              <li>
                <p class="education-period">{item.period}</p>
                <h3>{item.degree}</h3>
                <p class="education-institution">{item.institution}</p>
                {item.details && <p class="education-details">{item.details}</p>}
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section
        class="research-section section"
        id="research"
        aria-labelledby="research-title"
      >
        <div class="wrap">
          <div class="section-heading reveal">
            <h2 id="research-title">Research</h2>
          </div>
          <div class="research-grid">
            {research.map((item, index) => (
              <article
                class="research-item reveal"
                aria-labelledby={`research-item-${index}`}
              >
                <span class="research-number" aria-hidden="true">
                  {item.number}
                </span>
                <h3 id={`research-item-${index}`}>
                  <span>{item.title.split(" ").slice(0, -1).join(" ")} </span>
                  <span>{item.title.split(" ").pop()}</span>
                </h3>
                <p class="research-description">{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section
        class="section wrap publications"
        id="publications"
        aria-labelledby="publications-title"
      >
        <div class="section-heading reveal">
          <h2 id="publications-title">Publications</h2>
          <a
            class="text-link"
            href={profile.orcid}
            target="_blank"
            rel="noopener"
          >
            <Icon name="orcid" /> ORCID profile
          </a>
        </div>
        <div class="publication-tabs" role="tablist" aria-label="Publication type" hidden>
          {publicationGroups.map((group, index) => (
            <button
              type="button"
              role="tab"
              id={`${group.id}-tab`}
              aria-controls={group.id}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
            >
              {group.title}
            </button>
          ))}
        </div>
        <div class="publication-panels">
          <div class="publication-track">
          {publicationGroups.map((group) => (
          <div class="publication-group" id={group.id}>
            <h3 class="publication-group-title" id={`${group.id}-title`}>{group.title}</h3>
            <ol class="publication-list" aria-labelledby={`${group.id}-title`}>
              {group.papers.map((paper, index) => (
                <li class="reveal">
                  <span class="publication-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div class="publication-content">
                    <p class="publication-venue">{paper.venue}</p>
                    <h4>
                      {paper.href ? (
                        <a href={paper.href} target="_blank" rel="noopener">
                          {paper.title}
                        </a>
                      ) : (
                        paper.title
                      )}
                    </h4>
                    {paper.context && <p class="publication-context">{paper.context}</p>}
                    {paper.abstract && (
                      <details class="publication-abstract">
                        <summary>
                          Abstract
                          <Icon name="down" size={16} />
                          <span class="sr-only"> for {paper.title}</span>
                        </summary>
                        <p>{paper.abstract}</p>
                      </details>
                    )}
                  </div>
                  <span class="publication-year">{paper.year}</span>
                </li>
              ))}
            </ol>
          </div>
          ))}
          </div>
        </div>
      </section>

      <section
        class="software section wrap"
        id="software"
        aria-labelledby="software-title"
      >
        <div class="section-heading reveal">
          <h2 id="software-title">Software</h2>
          <a
            class="text-link"
            href={`${profile.github}?tab=repositories`}
            target="_blank"
            rel="noopener"
          >
            <Icon name="github" /> All repositories
          </a>
        </div>
        <ul
          class="repository-grid reveal"
          data-repositories
          aria-label="Public GitHub repositories"
        >
          {repositoryFallback.map((repository) => (
            <RepositoryCard repository={repository} />
          ))}
        </ul>
        <template data-repository-template>
          <RepositoryCard repository={repositoryFallback[0]} />
        </template>
      </section>

      <footer class="contact section" id="contact">
        <div class="wrap">
          <div class="contact-heading reveal">
            <h2>Contact</h2>
          </div>
          <a class="email" href={`mailto:${profile.email}`}>
            <Icon name="mail" /> <span>{profile.email}</span>
          </a>
          <div class="footer-bottom">
            <span>© {new Date().getFullYear()} SHEKUN WANG</span>
            <div>
              {profile.googleScholar && (
                <a href={profile.googleScholar} target="_blank" rel="noopener">
                  <Icon name="scholar" /> Google Scholar
                </a>
              )}
              <a href={profile.github} target="_blank" rel="noopener">
                <Icon name="github" /> GitHub
              </a>
              <a href={profile.orcid} target="_blank" rel="noopener">
                <Icon name="orcid" /> ORCID
              </a>
              {profile.linkedin && (
                <a href={profile.linkedin} target="_blank" rel="noopener">
                  <Icon name="linkedin" /> LinkedIn
                </a>
              )}
              <a href="/CV.pdf" target="_blank" rel="noopener">
                <Icon name="file" /> CV
              </a>
            </div>
            <a href="#home">
              Back to top <Icon name="up" />
            </a>
          </div>
        </div>
      </footer>
    </main>
    <script>
      import "../scripts/github";
      import "../scripts/publications";
      import "../scripts/pointer-field";
    </script>
    <script>
      let closedAbstractsForPrint: HTMLDetailsElement[] | undefined;
      window.addEventListener("beforeprint", () => {
        if (closedAbstractsForPrint) return;
        closedAbstractsForPrint = Array.from(
          document.querySelectorAll<HTMLDetailsElement>(".publication-abstract:not([open])"),
        );
        closedAbstractsForPrint.forEach((details) => { details.open = true; });
      });
      window.addEventListener("afterprint", () => {
        closedAbstractsForPrint?.forEach((details) => { details.open = false; });
        closedAbstractsForPrint = undefined;
      });
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#navigation");
      const header = document.querySelector<HTMLElement>(".site-header");
      const navLinks = Array.from(nav?.querySelectorAll<HTMLAnchorElement>("a") ?? []);
      const pageSections = Array.from(
        document.querySelectorAll<HTMLElement>("main section[id], footer[id]"),
      );
      const sectionFromHash = () => pageSections.find(
        (section) => `#${section.id}` === window.location.hash,
      )?.id;
      let navigationTarget = sectionFromHash();
      const updateNavigation = () => {
        const normalReadingLine = (header?.getBoundingClientRect().bottom ?? 0)
          + Math.min(120, window.innerHeight * 0.15);
        const viewportHeight = document.documentElement.clientHeight;
        const remainingScroll = Math.max(
          0,
          document.documentElement.scrollHeight - viewportHeight - window.scrollY,
        );
        // Follow the remaining content down the viewport as scrolling runs out.
        const readingLine = Math.max(normalReadingLine, viewportHeight - remainingScroll);
        let activeId = pageSections[0]?.id;
        for (const section of pageSections) {
          if (section.getBoundingClientRect().top <= readingLine) activeId = section.id;
        }
        if (navigationTarget) activeId = navigationTarget;
        navLinks.forEach((link) => {
          if (link.getAttribute("href") === `#${activeId}`) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };
      let navigationFrame = 0;
      const scheduleNavigationUpdate = () => {
        if (navigationFrame) return;
        navigationFrame = requestAnimationFrame(() => {
          navigationFrame = 0;
          updateNavigation();
        });
      };
      window.addEventListener("scroll", scheduleNavigationUpdate, { passive: true });
      window.addEventListener("resize", scheduleNavigationUpdate);
      window.addEventListener("load", scheduleNavigationUpdate);
      window.addEventListener("hashchange", () => {
        navigationTarget = sectionFromHash();
        scheduleNavigationUpdate();
      });
      const resumeReadingNavigation = () => {
        navigationTarget = undefined;
        scheduleNavigationUpdate();
      };
      window.addEventListener("wheel", resumeReadingNavigation, { passive: true });
      window.addEventListener("touchmove", resumeReadingNavigation, { passive: true });
      window.addEventListener("pointerdown", (event) => {
        if (event.clientX >= document.documentElement.clientWidth) resumeReadingNavigation();
      });
      scheduleNavigationUpdate();
      const closeMenu = (restoreFocus = false) => {
        toggle?.setAttribute("aria-expanded", "false");
        nav?.classList.remove("is-open");
        if (restoreFocus) toggle?.focus();
      };
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        nav?.classList.toggle("is-open", open);
      });
      document
        .querySelectorAll<HTMLAnchorElement>(
          "#navigation a, .scroll-cue, .footer-bottom > a",
        )
        .forEach((link) =>
          link.addEventListener("click", () => {
            closeMenu();
            const target = document.querySelector<HTMLElement>(
              link.getAttribute("href")!,
            );
            if (target) {
              navigationTarget = target.id;
              scheduleNavigationUpdate();
              target.tabIndex = -1;
              target.focus({ preventScroll: true });
            }
          }),
        );
      document.addEventListener("keydown", (event) => {
        if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End", " "].includes(event.key)) {
          resumeReadingNavigation();
        }
        if (
          event.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        )
          closeMenu(true);
      });
      window
        .matchMedia("(max-width: 1100px)")
        .addEventListener("change", () => closeMenu());

      if ("IntersectionObserver" in window) {
        const hero = document.querySelector(".hero");
        if (hero) {
          let inView = false;
          const updateHeroMotion = () => {
            hero.classList.toggle("is-active", inView && !document.hidden);
          };
          const heroObserver = new IntersectionObserver(([entry]) => {
            inView = entry.isIntersecting;
            updateHeroMotion();
          });
          heroObserver.observe(hero);
          document.addEventListener("visibilitychange", updateHeroMotion);
        }
        const cue = document.querySelector(".scroll-cue");
        if (cue) {
          const cueObserver = new IntersectionObserver(([entry]) => {
            cue.classList.toggle("is-in-view", entry.isIntersecting);
          });
          cueObserver.observe(cue);
        }
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll(".reveal").forEach((el) => {
          observer.observe(el);
          el.classList.add("will-reveal");
        });
      }
    </script>
  </body>
</html>
